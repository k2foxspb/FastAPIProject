# Files excluded from the EAS build archive (upload size).
# When .easignore exists, EAS ignores .gitignore, so the key ignores are listed here.
# See https://expo.fyi/eas-build-archive

# dependencies (installed on the EAS build worker)
node_modules/

# native project, regenerated by prebuild (gitignored)
/android/

# Expo / Metro / bundler outputs
.expo/
.expo-export-tmp/
dist/
web-build/
.metro-health-check*
expo-env.d.ts

# debug logs
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store

# secrets not needed by the mobile build
firebase-service-account.json
*.jks
*.p8
*.p12
*.key
*.mobileprovision
